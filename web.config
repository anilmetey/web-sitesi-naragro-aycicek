<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- www → non-www 301 Redirect -->
    <rewrite>
      <rules>
        <rule name="WWW to non-WWW" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.naragro\.com\.tr$" />
          </conditions>
          <action type="Redirect" url="https://naragro.com.tr/{R:0}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- MIME types for sitemap and robots -->
    <staticContent>
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
    </staticContent>

  </system.webServer>
</configuration>
